<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".KameraGestureActivity">

    <!-- Camera Preview menggunakan AutoFitSurfaceView - fullscreen -->
    <com.example.isyaratkita.utils.AutoFitSurfaceView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Overlay View untuk Bounding Box -->
    <com.example.isyaratkita.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tombol Close -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/button_background_transparent"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/close"
        app:tint="@android:color/white" />

    <!-- Tombol Switch Kamera -->
    <ImageButton
        android:id="@+id/btn_switch_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/button_background_transparent"
        android:src="@drawable/ic_switch_camera"
        android:contentDescription="@string/switch_camera"
        app:tint="@android:color/white" />

    <!-- Teks Gesture di Bawah -->
    <TextView
        android:id="@+id/gesture_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/detecting_gesture"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Confidence Text -->

    <!-- FPS & Inference Time Counter -->

    <TextView
        android:id="@+id/confidence_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="66dp"
        android:background="@drawable/text_background"
        android:padding="8dp"
        android:text="Confidence: --"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/fps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="80dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/text_background"
        android:padding="8dp"
        android:text="FPS: -- | --ms"
        android:textColor="@android:color/white"
        android:textSize="14sp" />
</FrameLayout>
